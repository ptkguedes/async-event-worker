# Copie para .env e ajuste se precisar: os valores abaixo sao os defaults de
# desenvolvimento local e NAO devem ser usados em nenhum outro ambiente.

# --- Aplicacao ---
APP_NAME=async-event-worker
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- API HTTP ---
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL ---
# Use host "postgres" dentro do Compose e "localhost" ao rodar fora dos containers.
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/async_event_worker
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Credenciais do container do Postgres (somente dev local)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=async_event_worker
POSTGRES_PORT=5432

# --- RabbitMQ ---
AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# Credenciais do container do RabbitMQ (somente dev local)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Topologia ---
# Prefixo aplicado a todos os nomes de exchange/fila; vazio em dev,
# a suite de integracao usa "test_" para nao competir com o worker do Compose.
TOPOLOGY_PREFIX=
TASKS_EXCHANGE=tasks.exchange
RETRY_EXCHANGE=tasks.retry.exchange
DLX_EXCHANGE=tasks.dlx.exchange
TASKS_QUEUE=tasks
RETRY_QUEUE=tasks.retry
DLX_QUEUE=dlx_tasks
TASKS_ROUTING_KEY=tasks.process
RETRY_ROUTING_KEY=tasks.retry
DLX_ROUTING_KEY=tasks.dead

# --- Resiliencia ---
# 3 retentativas automaticas (4 processamentos no total) antes de ir para dlx_tasks.
TASK_MAX_RETRIES=3
# Atraso entre as retentativas, via x-message-ttl da fila de retry (ms).
RETRY_TTL_MS=5000

# --- Worker ---
WORKER_PREFETCH_COUNT=10
# Duracao do processamento simulado (segundos).
PROCESSING_DELAY_SECONDS=0.5
