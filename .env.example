# Copie para .env e ajuste se precisar: os valores abaixo sao os defaults de
# desenvolvimento local e NAO devem ser usados em nenhum outro ambiente.

# --- Aplicacao ---
APP_NAME=async-event-worker
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- API HTTP ---
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL ---
# Estas sao as variaveis RAIZ: o container do Postgres e a aplicacao leem as
# mesmas, e app/core/config.py deriva DATABASE_URL a partir delas. Trocar a
# senha aqui basta para toda a stack (a senha e percent-encoded na derivacao).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=async_event_worker
# Host/porta de CONEXAO da aplicacao: "postgres"/5432 dentro do Compose,
# "localhost"/POSTGRES_PORT ao rodar fora dos containers.
POSTGRES_HOST=postgres
# Porta PUBLICADA no host pelo docker-compose.yml.
POSTGRES_PORT=5432

# Override OPCIONAL: se definida (nao vazia), vence a derivacao acima.
# DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/async_event_worker
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Timeouts de I/O do banco. Sem eles, um Postgres que aceita o TCP e nunca
# responde penduraria o callback do worker antes de qualquer ack/nack.
# Limite para ABRIR a conexao (segundos).
DB_CONNECT_TIMEOUT_SECONDS=3.0
# Limite por STATEMENT (milissegundos). Vale para a API e o worker; as
# migrations do Alembic NAO sao afetadas (o alembic/env.py monta a propria
# engine), portanto um DDL longo nao pode ser morto no meio.
#
# INVARIANTE: DB_CONNECT_TIMEOUT_SECONDS + DB_STATEMENT_TIMEOUT_MS/1000 (8s) e
# o teto do tempo que um worker pode ficar preso em I/O de banco, e ele tem de
# caber DENTRO de CLAIM_LEASE_SECONDS (15s).
DB_STATEMENT_TIMEOUT_MS=5000

# --- RabbitMQ ---
# Variaveis raiz (os nomes que a imagem do RabbitMQ ja usa); AMQP_URL e
# derivada delas.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_VHOST=/
# Porta PUBLICADA no host pelo docker-compose.yml.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Override OPCIONAL: se definida (nao vazia), vence a derivacao acima.
# AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# --- Topologia ---
# Prefixo aplicado a todos os nomes de exchange/fila; vazio em dev,
# a suite de integracao usa "test_" para nao competir com o worker do Compose.
TOPOLOGY_PREFIX=
TASKS_EXCHANGE=tasks.exchange
RETRY_EXCHANGE=tasks.retry.exchange
DLX_EXCHANGE=tasks.dlx.exchange
TASKS_QUEUE=tasks
RETRY_QUEUE=tasks.retry
DLX_QUEUE=dlx_tasks
TASKS_ROUTING_KEY=tasks.process
RETRY_ROUTING_KEY=tasks.retry
DLX_ROUTING_KEY=tasks.dead

# --- Resiliencia ---
# 3 retentativas automaticas (4 processamentos no total) antes de ir para dlx_tasks.
TASK_MAX_RETRIES=3
# Atraso entre as retentativas, via x-message-ttl da fila de retry (ms).
# Define quando cada reentrega chega: ~0s, 10s, 20s, 30s. Tem de ser folgado
# sobre CLAIM_LEASE_SECONDS para que o claim de um worker morto expire com
# tempo de sobra dentro do orcamento de retentativas.
# ATENCAO: e argumento de fila (x-message-ttl). Mudar exige recriar a fila
# tasks.retry, senao a declaracao falha com PRECONDITION_FAILED (406).
RETRY_TTL_MS=10000

# --- Worker ---
WORKER_PREFETCH_COUNT=10
# Duracao do processamento simulado (segundos).
PROCESSING_DELAY_SECONDS=0.5
# Lease do claim idempotente: por quantos segundos uma linha PROCESSING
# pertence ao consumidor que a reclamou. Presa entre dois limites:
#   PISO: > DB_CONNECT_TIMEOUT_SECONDS + DB_STATEMENT_TIMEOUT_MS/1000 (8s), e
#         tambem >= PROCESSING_DELAY_SECONDS.
#   TETO: < 2 * RETRY_TTL_MS/1000 (20s).
CLAIM_LEASE_SECONDS=15.0
